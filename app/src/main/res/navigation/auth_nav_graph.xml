<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/auth_nav_graph"
    app:startDestination="@id/welcomeFragment">

    <!-- ========== WELCOME ========== -->
    <fragment
        android:id="@+id/welcomeFragment"
        android:name="com.example.trimly.ui.auth.WelcomeFragment"
        android:label="Welcome"
        tools:layout="@layout/welcome_fragment">
        <action
            android:id="@+id/action_welcome_to_roleSelection"
            app:destination="@id/roleSelectionFragment" />
        <action
            android:id="@+id/action_welcome_to_login"
            app:destination="@id/loginFragment" />
    </fragment>

    <!-- ========== ROLE SELECTION ========== -->
    <fragment
        android:id="@+id/roleSelectionFragment"
        android:name="com.example.trimly.ui.auth.RoleSelectionFragment"
        android:label="Select Role">
        <action
            android:id="@+id/action_roleSelection_to_signup"
            app:destination="@id/signupFragment" />
    </fragment>

    <!-- ========== LOGIN / SIGNUP ========== -->
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.trimly.ui.auth.LoginFragment"
        android:label="Login">
        <action
            android:id="@+id/action_login_to_signup"
            app:destination="@id/signupFragment" />
    </fragment>

    <fragment
        android:id="@+id/signupFragment"
        android:name="com.example.trimly.ui.auth.SignupFragment"
        android:label="Signup">
        <action
            android:id="@+id/action_signup_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- ========== CLIENT SETUP ========== -->
    <fragment
        android:id="@+id/clientSetupFragment"
        android:name="com.example.trimly.ui.auth.ClientSetupFragment">
        <action
            android:id="@+id/action_clientSetup_to_googleAuth"
            app:destination="@id/clientGoogleAuthFragment" />
        <action
            android:id="@+id/action_clientSetup_to_guestSetup"
            app:destination="@id/clientGuestSetupFragment" />
    </fragment>

    <fragment
        android:id="@+id/clientGoogleAuthFragment"
        android:name="com.example.trimly.ui.auth.ClientGoogleAuthFragment">
        <action
            android:id="@+id/action_googleAuth_to_clientLocation"
            app:destination="@id/clientLocationFragment" />
    </fragment>

    <fragment
        android:id="@+id/clientGuestSetupFragment"
        android:name="com.example.trimly.ui.auth.ClientGuestSetupFragment">
        <action
            android:id="@+id/action_guestSetup_to_clientLocation"
            app:destination="@id/clientLocationFragment" />
    </fragment>

    <fragment
        android:id="@+id/clientLocationFragment"
        android:name="com.example.trimly.ui.auth.ClientLocationFragment">
        <action
            android:id="@+id/action_location_to_success"
            app:destination="@id/setupSuccessFragment" />
    </fragment>

    <!-- ========== BARBER SETUP ========== -->
    <fragment
        android:id="@+id/barberSetupFragment"
        android:name="com.example.trimly.ui.auth.BarberSetupFragment" />
    <fragment
        android:id="@+id/barberPortfolioFragment"
        android:name="com.example.trimly.ui.auth.BarberPortfolioFragment" />

    <!-- ========== ADMIN SETUP ========== -->
    <fragment
        android:id="@+id/adminSetupFragment"
        android:name="com.example.trimly.ui.auth.AdminSetupFragment" />
    <fragment
        android:id="@+id/adminHoursFragment"
        android:name="com.example.trimly.ui.auth.AdminHoursFragment" />
    <fragment
        android:id="@+id/adminServicesFragment"
        android:name="com.example.trimly.ui.auth.AdminServicesFragment">
        <action
            android:id="@+id/action_admin_to_success"
            app:destination="@id/setupSuccessFragment" />
    </fragment>

    <!-- ========== SUCCESS ========== -->
    <fragment
        android:id="@+id/setupSuccessFragment"
        android:name="com.example.trimly.ui.auth.SetupSuccessFragment" />

</navigation>