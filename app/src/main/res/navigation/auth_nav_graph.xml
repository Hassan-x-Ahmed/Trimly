<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/auth_nav_graph"
    app:startDestination="@id/roleSelectionFragment">

    <fragment android:id="@+id/roleSelectionFragment" android:name="com.example.trimly.ui.auth.RoleSelectionFragment" android:label="Select Role">
        <action android:id="@+id/action_roleSelection_to_client_setup" app:destination="@id/clientSetupFragment" />
        <action android:id="@+id/to_barber_setup" app:destination="@id/barberSetupFragment" />
        <action android:id="@+id/to_admin_setup" app:destination="@id/adminSetupFragment" />
    </fragment>

    <fragment android:id="@+id/loginFragment" android:name="com.example.trimly.ui.auth.LoginFragment" android:label="Login">
        <action android:id="@+id/action_login_to_signup" app:destination="@id/signupFragment" />
    </fragment>
    <fragment android:id="@+id/signupFragment" android:name="com.example.trimly.ui.auth.SignupFragment" android:label="Signup">
        <action android:id="@+id/action_signup_to_login" app:destination="@id/loginFragment" app:popUpTo="@id/loginFragment" app:popUpToInclusive="true"/>
    </fragment>

    <fragment android:id="@+id/clientSetupFragment" android:name="com.example.trimly.ui.auth.ClientSetupFragment">
        <action android:id="@+id/action_clientSetup_to_googleAuth" app:destination="@id/clientGoogleAuthFragment" />
        <action android:id="@+id/action_clientSetup_to_guestSetup" app:destination="@id/clientGuestSetupFragment" />
    </fragment>
    <fragment android:id="@+id/clientGoogleAuthFragment" android:name="com.example.trimly.ui.auth.ClientGoogleAuthFragment">
        <action android:id="@+id/action_googleAuth_to_clientLocation" app:destination="@id/clientLocationFragment" />
    </fragment>
    <fragment android:id="@+id/clientGuestSetupFragment" android:name="com.example.trimly.ui.auth.ClientGuestSetupFragment">
        <action android:id="@+id/action_guestSetup_to_clientLocation" app:destination="@id/clientLocationFragment" />
    </fragment>
    <fragment android:id="@+id/clientLocationFragment" android:name="com.example.trimly.ui.auth.ClientLocationFragment">
        <action android:id="@+id/action_location_to_success" app:destination="@id/setupSuccessFragment" />
    </fragment>

    <fragment android:id="@+id/barberSetupFragment" android:name="com.example.trimly.ui.auth.BarberSetupFragment" />
    <fragment android:id="@+id/barberPortfolioFragment" android:name="com.example.trimly.ui.auth.BarberPortfolioFragment" />

    <fragment android:id="@+id/adminSetupFragment" android:name="com.example.trimly.ui.auth.AdminSetupFragment" />
    <fragment android:id="@+id/adminHoursFragment" android:name="com.example.trimly.ui.auth.AdminHoursFragment" />
    <fragment android:id="@+id/adminServicesFragment" android:name="com.example.trimly.ui.auth.AdminServicesFragment">
        <action android:id="@+id/action_admin_to_success" app:destination="@id/setupSuccessFragment" />
    </fragment>

    <fragment android:id="@+id/setupSuccessFragment" android:name="com.example.trimly.ui.auth.SetupSuccessFragment" />

</navigation>