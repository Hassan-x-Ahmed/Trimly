<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ffffff">

    <View
        android:id="@+id/header_bg"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:background="#c8e6c9"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="← Shop Owner (Step 3/3)"
        android:textSize="16sp"
        android:textColor="#000000"
        android:layout_marginStart="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/header_bg"
        app:layout_constraintBottom_toBottomOf="@id/header_bg"/>

    <ImageView
        android:id="@+id/img_service_icon"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:layout_marginTop="20dp"
        android:src="@android:drawable/ic_menu_sort_by_size"
        app:tint="#388e3c"
        app:layout_constraintTop_toBottomOf="@id/header_bg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add Services &amp; Pricing"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/img_service_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tv_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="(Step 3/3)"
        android:textSize="16sp"
        android:textColor="#000000"
        app:layout_constraintTop_toBottomOf="@id/tv_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tv_list_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Master Service List"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#388e3c"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/tv_subtitle"
        app:layout_constraintStart_toStartOf="parent"/>

    <LinearLayout
        android:id="@+id/service_list_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/tv_list_label">

        <LinearLayout android:layout_width="match_parent" android:layout_height="70dp" android:background="@android:drawable/dialog_holo_light_frame" android:gravity="center_vertical" android:paddingHorizontal="10dp" android:layout_marginBottom="10dp">
            <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@android:drawable/ic_menu_crop" app:tint="#388e3c" android:background="#e8f5e9" android:padding="8dp"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="10dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Men's Classic Cut" android:textStyle="bold" android:textColor="#000"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Salon Price (PKR)" android:textSize="10sp"/>
                <EditText android:layout_width="80dp" android:layout_height="30dp" android:background="@android:drawable/editbox_background_normal" android:text="1500" android:textSize="12sp" android:paddingStart="5dp" android:inputType="number"/>
            </LinearLayout>
            <Switch android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:thumbTint="#d4af37" android:trackTint="#388e3c"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="70dp" android:background="@android:drawable/dialog_holo_light_frame" android:gravity="center_vertical" android:paddingHorizontal="10dp" android:layout_marginBottom="10dp">
            <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@android:drawable/ic_menu_camera" app:tint="#388e3c" android:background="#e8f5e9" android:padding="8dp"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="10dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Classic Shave" android:textStyle="bold" android:textColor="#000"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Salon Price (PKR)" android:textSize="10sp"/>
                <EditText android:layout_width="80dp" android:layout_height="30dp" android:background="@android:drawable/editbox_background_normal" android:text="1000" android:textSize="12sp" android:paddingStart="5dp" android:inputType="number"/>
            </LinearLayout>
            <Switch android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:thumbTint="#d4af37" android:trackTint="#388e3c"/>
        </LinearLayout>

    </LinearLayout>

    <Button
        android:id="@+id/btn_finish_admin"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="30dp"
        android:text="FINISH SETUP &amp; LAUNCH SALON >"
        android:backgroundTint="#388e3c"
        android:textColor="#ffffff"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>