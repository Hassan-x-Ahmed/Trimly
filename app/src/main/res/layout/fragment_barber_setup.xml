<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ffffff">

    <View
        android:id="@+id/top_bg"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="#b2dfdb"
        app:layout_constraintTop_toTopOf="parent"/>

    <ImageView
        android:id="@+id/back_btn"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="20dp"
        android:src="@android:drawable/ic_menu_revert"
        app:tint="#333333"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/top_bg"
        app:layout_constraintBottom_toBottomOf="@id/top_bg"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Barber Profile Setup - Step 1/2"
        android:textSize="16sp"
        android:textColor="#333333"
        android:layout_marginStart="15dp"
        app:layout_constraintStart_toEndOf="@id/back_btn"
        app:layout_constraintTop_toTopOf="@id/back_btn"
        app:layout_constraintBottom_toBottomOf="@id/back_btn"/>

    <ImageView
        android:id="@+id/barber_icon"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="20dp"
        android:src="@android:drawable/ic_menu_camera"
        app:tint="#d4af37"
        app:layout_constraintTop_toBottomOf="@id/top_bg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/page_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Create Your Barber Profile"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/barber_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ImageView
        android:id="@+id/upload_circle"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginTop="15dp"
        android:background="@android:drawable/ic_menu_add"
        android:backgroundTint="#4ca69c"
        app:layout_constraintTop_toBottomOf="@id/page_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/upload_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Upload Profile Photo"
        android:textSize="14sp"
        android:textColor="#000000"
        android:layout_marginTop="5dp"
        app:layout_constraintTop_toBottomOf="@id/upload_circle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <EditText
        android:id="@+id/et_barber_name"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginHorizontal="30dp"
        android:layout_marginTop="20dp"
        android:background="@android:drawable/editbox_background_normal"
        android:hint="Full Name"
        android:paddingStart="15dp"
        app:layout_constraintTop_toBottomOf="@id/upload_text"/>

    <EditText
        android:id="@+id/et_experience"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginHorizontal="30dp"
        android:layout_marginTop="15dp"
        android:background="@android:drawable/editbox_background_normal"
        android:hint="Years of Experience"
        android:inputType="number"
        android:drawableStart="@android:drawable/ic_menu_edit"
        android:drawablePadding="10dp"
        android:paddingStart="15dp"
        app:layout_constraintTop_toBottomOf="@id/et_barber_name"/>

    <EditText
        android:id="@+id/et_bio"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginHorizontal="30dp"
        android:layout_marginTop="15dp"
        android:background="@android:drawable/editbox_background_normal"
        android:hint="Bio/Specialties\n(e.g. Skin Fade Master)"
        android:gravity="top|start"
        android:padding="15dp"
        app:layout_constraintTop_toBottomOf="@id/et_experience"/>

    <Button
        android:id="@+id/btn_next_barber"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginHorizontal="30dp"
        android:layout_marginBottom="40dp"
        android:text="NEXT: Upload Portfolio >"
        android:backgroundTint="#d4af37"
        android:textColor="#ffffff"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>