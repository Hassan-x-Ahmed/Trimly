<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080E0D">

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome to Trimly\n(Client Setup)"
        android:textAlignment="center"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_marginTop="60dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ImageView
        android:id="@+id/hero_img"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_marginTop="30dp"
        android:src="@android:drawable/btn_star_big_on"
        app:tint="#D4AF37"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/desc"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:text="Access your rewards and bookings instantly."
        android:textAlignment="center"
        android:textSize="16sp"
        android:textColor="#B2DFDB"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/hero_img"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/btn_google"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="30dp"
        android:layout_marginTop="40dp"
        android:text="Continue with Google"
        android:textColor="#FFFFFF"
        android:backgroundTint="#CC1A2422"
        app:icon="@android:drawable/ic_menu_myplaces"
        app:iconTint="#D4AF37"
        app:iconGravity="textStart"
        app:strokeColor="#33D4AF37"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/desc"/>

    <Button
        android:id="@+id/btn_guest"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="30dp"
        android:layout_marginTop="16dp"
        android:text="Continue as Guest"
        android:textColor="#FFFFFF"
        android:backgroundTint="#0D1211"
        app:strokeColor="#33FFFFFF"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/btn_google"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Secure, automatic setup of your name and photo."
        android:textSize="12sp"
        android:textColor="#888888"
        android:layout_marginBottom="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>