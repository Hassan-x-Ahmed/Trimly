<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ffffff">

    <View
        android:id="@+id/top_bg"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="#b2dfdb"
        app:layout_constraintTop_toTopOf="parent"/>

    <ImageView
        android:id="@+id/back_btn"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="20dp"
        android:src="@android:drawable/ic_menu_revert"
        app:tint="#333333"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/top_bg"
        app:layout_constraintBottom_toBottomOf="@id/top_bg"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Barber Portfolio (Step 2/2)"
        android:textSize="16sp"
        android:textColor="#333333"
        android:layout_marginStart="15dp"
        app:layout_constraintStart_toEndOf="@id/back_btn"
        app:layout_constraintTop_toTopOf="@id/back_btn"
        app:layout_constraintBottom_toBottomOf="@id/back_btn"/>

    <ImageView
        android:id="@+id/barber_icon"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="20dp"
        android:src="@android:drawable/ic_menu_gallery"
        app:tint="#d4af37"
        app:layout_constraintTop_toBottomOf="@id/top_bg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/page_title"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="Showcase your signature haircuts (Max 20)."
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:textAlignment="center"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/barber_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <GridLayout
        android:id="@+id/photo_grid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:columnCount="3"
        android:rowCount="2"
        android:alignmentMode="alignMargins"
        app:layout_constraintTop_toBottomOf="@id/page_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout android:layout_width="90dp" android:layout_height="120dp" android:orientation="vertical" android:background="@android:drawable/dialog_holo_light_frame" android:layout_margin="5dp" android:gravity="center">
            <ImageView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:src="@android:drawable/sym_def_app_icon" android:scaleType="centerCrop"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Haircut 1" android:textSize="10sp" android:textAlignment="center" android:padding="2dp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="90dp" android:layout_height="120dp" android:orientation="vertical" android:background="#f0f0f0" android:layout_margin="5dp" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+" android:textSize="24sp" android:textColor="#00695c"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ADD PHOTO" android:textSize="10sp" android:textColor="#000" android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout android:layout_width="90dp" android:layout_height="120dp" android:orientation="vertical" android:background="#f0f0f0" android:layout_margin="5dp" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+" android:textSize="24sp" android:textColor="#00695c"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ADD PHOTO" android:textSize="10sp" android:textColor="#000" android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout android:layout_width="90dp" android:layout_height="120dp" android:orientation="vertical" android:background="#f0f0f0" android:layout_margin="5dp" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+" android:textSize="24sp" android:textColor="#00695c"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ADD PHOTO" android:textSize="10sp" android:textColor="#000" android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout android:layout_width="90dp" android:layout_height="120dp" android:orientation="vertical" android:background="#f0f0f0" android:layout_margin="5dp" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+" android:textSize="24sp" android:textColor="#00695c"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ADD PHOTO" android:textSize="10sp" android:textColor="#000" android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout android:layout_width="90dp" android:layout_height="120dp" android:orientation="vertical" android:background="#f0f0f0" android:layout_margin="5dp" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+" android:textSize="24sp" android:textColor="#00695c"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ADD PHOTO" android:textSize="10sp" android:textColor="#000" android:textStyle="bold"/>
        </LinearLayout>

    </GridLayout>

    <TextView
        android:id="@+id/helper_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tap '+' to add images. Drag to reorder."
        android:textSize="12sp"
        android:textColor="#757575"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/photo_grid"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/btn_submit_barber"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginHorizontal="30dp"
        android:layout_marginBottom="40dp"
        android:text="SUBMIT PROFILE"
        android:backgroundTint="#d4af37"
        android:textColor="#ffffff"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>