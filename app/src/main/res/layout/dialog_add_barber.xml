<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#121A18"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Invite Barber"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Enter the email address of a registered Trimly Barber to link them to your salon."
        android:textColor="#999999"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/et_barber_email"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_input_beige"
        android:hint="barber@email.com"
        android:inputType="textEmailAddress"
        android:paddingHorizontal="16dp"
        android:textColor="#080E0D"
        android:textColorHint="#66080E0D" />

</LinearLayout>