<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080E0D"> <View
    android:id="@+id/top_bg"
    android:layout_width="match_parent"
    android:layout_height="70dp"
    android:background="#121212"
    app:layout_constraintTop_toTopOf="parent"/>

    <ImageView
        android:id="@+id/back_btn"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        android:background="@drawable/ic_circle_gold_border"
        android:padding="10dp"
        android:src="@android:drawable/ic_menu_revert"
        app:tint="#D4AF37"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/top_bg"
        app:layout_constraintBottom_toBottomOf="@id/top_bg"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Salon Registration - Step 1/3"
        android:textSize="14sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toEndOf="@id/back_btn"
        app:layout_constraintTop_toTopOf="@id/back_btn"
        app:layout_constraintBottom_toBottomOf="@id/back_btn"/>

    <ImageView
        android:id="@+id/salon_icon"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="30dp"
        android:src="@android:drawable/ic_menu_agenda"
        app:tint="#D4AF37"
        app:layout_constraintTop_toBottomOf="@id/top_bg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/page_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Register Your Salon"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_marginTop="15dp"
        app:layout_constraintTop_toBottomOf="@id/salon_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <EditText
        android:id="@+id/et_salon_name"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginHorizontal="30dp"
        android:layout_marginTop="30dp"
        android:background="#CC1A2422"
        android:hint="Salon Name (e.g. Élysian Noir)"
        android:textColor="#FFFFFF"
        android:textColorHint="#999999"
        android:paddingStart="15dp"
        android:inputType="textPersonName"
        app:layout_constraintTop_toBottomOf="@id/page_title"/>

    <EditText
        android:id="@+id/et_address"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginHorizontal="30dp"
        android:layout_marginTop="15dp"
        android:background="#CC1A2422"
        android:hint="Business Address"
        android:textColor="#FFFFFF"
        android:textColorHint="#999999"
        android:drawableStart="@android:drawable/ic_menu_mylocation"
        android:drawableTint="#D4AF37"
        android:drawablePadding="10dp"
        android:paddingStart="15dp"
        app:layout_constraintTop_toBottomOf="@id/et_salon_name"/>

    <EditText
        android:id="@+id/et_phone"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginHorizontal="30dp"
        android:layout_marginTop="15dp"
        android:background="#CC1A2422"
        android:hint="Phone Number"
        android:textColor="#FFFFFF"
        android:textColorHint="#999999"
        android:inputType="phone"
        android:drawableStart="@android:drawable/ic_menu_call"
        android:drawableTint="#D4AF37"
        android:drawablePadding="10dp"
        android:paddingStart="15dp"
        app:layout_constraintTop_toBottomOf="@id/et_address"/>

    <Button
        android:id="@+id/btn_next_admin"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginHorizontal="30dp"
        android:layout_marginBottom="40dp"
        android:text="NEXT: Setup Operating Hours"
        android:backgroundTint="#D4AF37"
        android:textColor="#080E0D"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>