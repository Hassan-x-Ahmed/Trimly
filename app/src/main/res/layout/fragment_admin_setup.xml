<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF6F2">

    <!-- Charcoal top bar -->
    <View
        android:id="@+id/top_bg"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="#1E1E24"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- Back button with gold ring -->
    <ImageView
        android:id="@+id/back_btn"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        android:background="@drawable/ic_circle_gold_border"
        android:padding="10dp"
        android:src="@android:drawable/ic_menu_revert"
        app:tint="#C8963E"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/top_bg"
        app:layout_constraintBottom_toBottomOf="@id/top_bg"/>

    <!-- Step indicator -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Salon Registration - Step 1/3"
        android:textSize="14sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toEndOf="@id/back_btn"
        app:layout_constraintTop_toTopOf="@id/back_btn"
        app:layout_constraintBottom_toBottomOf="@id/back_btn"/>

    <!-- Salon icon (brass) -->
    <ImageView
        android:id="@+id/salon_icon"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="30dp"
        android:src="@android:drawable/ic_menu_agenda"
        app:tint="#C8963E"
        app:layout_constraintTop_toBottomOf="@id/top_bg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Page title -->
    <TextView
        android:id="@+id/page_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Register Your Salon"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#111111"
        android:layout_marginTop="15dp"
        app:layout_constraintTop_toBottomOf="@id/salon_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Salon name -->
    <EditText
        android:id="@+id/et_salon_name"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginHorizontal="30dp"
        android:layout_marginTop="30dp"
        android:background="@android:drawable/editbox_background_normal"
        android:hint="Salon Name"
        android:textColor="#111111"
        android:textColorHint="#6B6360"
        android:paddingStart="15dp"
        app:layout_constraintTop_toBottomOf="@id/page_title"/>

    <!-- Business address -->
    <EditText
        android:id="@+id/et_address"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginHorizontal="30dp"
        android:layout_marginTop="15dp"
        android:background="@android:drawable/editbox_background_normal"
        android:hint="Business Address"
        android:textColor="#111111"
        android:textColorHint="#6B6360"
        android:drawableStart="@android:drawable/ic_menu_mylocation"
        android:drawableTint="#C8963E"
        android:drawablePadding="10dp"
        android:paddingStart="15dp"
        app:layout_constraintTop_toBottomOf="@id/et_salon_name"/>

    <!-- Phone number -->
    <EditText
        android:id="@+id/et_phone"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginHorizontal="30dp"
        android:layout_marginTop="15dp"
        android:background="@android:drawable/editbox_background_normal"
        android:hint="Phone Number"
        android:textColor="#111111"
        android:textColorHint="#6B6360"
        android:inputType="phone"
        android:drawableStart="@android:drawable/ic_menu_call"
        android:drawableTint="#C8963E"
        android:drawablePadding="10dp"
        android:paddingStart="15dp"
        app:layout_constraintTop_toBottomOf="@id/et_address"/>

    <!-- Next button (brass) -->
    <Button
        android:id="@+id/btn_next_admin"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginHorizontal="30dp"
        android:layout_marginBottom="40dp"
        android:text="NEXT: Setup Operating Hours"
        android:backgroundTint="#C8963E"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>