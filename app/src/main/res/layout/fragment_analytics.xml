                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="4PM" android:textAlignment="center" android:textColor="#D4AF37" android:textSize="8sp" android:textStyle="bold" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="6PM" android:textAlignment="center" android:textColor="#D4AF37" android:textSize="8sp" android:textStyle="bold" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="8PM" android:textAlignment="center" android:textColor="#888888" android:textSize="8sp" />
                    </LinearLayout>
